---
const apps = [
  {
    tag: 'Móvil · Ionic/Angular',
    title: 'App Ticketero',
    body: 'El valet recibe el vehículo, genera el boleto digital y registra el resguardo en segundos.',
    color: 'orange',
    icon: 'M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12a1.5 1.5 0 01-1.493 1.653H3.624a1.5 1.5 0 01-1.493-1.653l1.263-12A1.5 1.5 0 014.887 7.5h14.226a1.5 1.5 0 011.493 1.007z',
  },
  {
    tag: 'Móvil · Ionic/Angular',
    title: 'App Cajero',
    body: 'Cobro al cliente, cierre del boleto y entrega del vehículo, todo trazado en el mismo flujo.',
    color: 'green',
    icon: 'M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z',
  },
  {
    tag: 'Escritorio · Angular',
    title: 'Web Admin',
    body: 'Dashboard, empleados, turnos, reportes y bitácora forense de auditoría, todo en un panel.',
    color: 'ink',
    icon: 'M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5',
  },
];

const colorMap: Record<string, { bg: string; text: string; ring: string }> = {
  orange: { bg: 'bg-orange-50', text: 'text-orange-600', ring: 'group-hover:border-orange-500/30' },
  green: { bg: 'bg-green-50', text: 'text-green-700', ring: 'group-hover:border-green-500/30' },
  ink: { bg: 'bg-ink-700/5', text: 'text-ink-700', ring: 'group-hover:border-ink-700/20' },
};
---

<section id="producto" class="bg-cream-100 py-20 sm:py-24" aria-labelledby="producto-heading">
  <div class="container-px">
    <div class="max-w-2xl">
      <span class="eyebrow">El producto</span>
      <h2 id="producto-heading" class="section-title mt-4">Tres superficies, una sola operación</h2>
      <p class="section-lede">
        ProParking se compone de tres aplicaciones que comparten el mismo backend y la misma base de
        datos, para que cada boleto se pueda seguir desde que entra el auto hasta que sale.
      </p>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {apps.map((app) => {
        const c = colorMap[app.color];
        return (
          <div class={`group card border-2 border-transparent ${c.ring}`}>
            <div class={`flex h-12 w-12 items-center justify-center rounded-xl ${c.bg} ${c.text}`}>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d={app.icon} />
              </svg>
            </div>
            <p class={`mt-5 text-xs font-bold uppercase tracking-widest ${c.text}`}>{app.tag}</p>
            <h3 class="mt-2 text-xl">{app.title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-ink-400">{app.body}</p>
          </div>
        );
      })}
    </div>

    <p class="mt-8 max-w-2xl text-sm text-ink-400">
      Backend único compartido — API REST en Java/Spring con base de datos PostgreSQL — que mantiene
      sincronizadas las tres aplicaciones en tiempo real.
    </p>
  </div>
</section>
