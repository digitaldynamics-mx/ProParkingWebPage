---

<section id="beneficios" class="bg-cream-100 py-20 sm:py-24" aria-labelledby="beneficios-heading">
  <div class="container-px">
    <div class="max-w-2xl">
      <span class="eyebrow">Beneficios</span>
      <h2 id="beneficios-heading" class="section-title mt-4">Lo que gana el dueño del negocio</h2>
      <p class="section-lede">No vendemos software: resolvemos un problema operativo real, con una herramienta en la que el dueño puede confiar.</p>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {benefits.map((b) => (
        <div class="card">
          <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-green-50 text-green-700">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d={b.icon} />
            </svg>
          </div>
          <h3 class="mt-4 text-lg">{b.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-400">{b.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
