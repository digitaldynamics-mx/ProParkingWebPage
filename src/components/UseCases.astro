---
// Nota para el equipo: en cuanto existan testimonios reales de clientes,
// esta sección es el lugar natural para sustituirlos (mismo slider, mismo patrón de cards).
const cases = [
  {
    segment: 'Hoteles',
    title: 'Valet de huéspedes, sin boletos extraviados',
    body: 'Cada auto queda ligado a la reservación del huésped, con resguardo trazado desde la llegada hasta el checkout.',
    icon: 'M3 21V8.25a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 8.25V21M3 21h18M3 21h18M9 7.5h.01M15 7.5h.01M9 12h.01M15 12h.01M9 16.5h6',
  },
  {
    segment: 'Restaurantes',
    title: 'Rotación rápida en horas pico, con control total',
    body: 'El equipo de valet recibe, resguarda y entrega vehículos a toda velocidad sin perder trazabilidad ni cobros.',
    icon: 'M8.25 3v1.5M4.5 8.25h15M5.25 21h13.5A2.25 2.25 0 0021 18.75V8.25A2.25 2.25 0 0018.75 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21z',
  },
  {
    segment: 'Eventos',
    title: 'Picos de cientos de vehículos, en un solo panel',
    body: 'Escala el número de ticketeros y cajeros activos para el evento, y audita todo desde el Web Admin al día siguiente.',
    icon: 'M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.562.562 0 00-.586 0L6.982 21.03a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.562.562 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z',
  },
];
---

<section class="bg-white py-20 sm:py-24" aria-labelledby="casos-heading">
  <div class="container-px">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <span class="eyebrow">Para quién es</span>
        <h2 id="casos-heading" class="section-title mt-4">Pensado para negocios con valet parking</h2>
        <p class="section-lede">Un mismo producto, adaptado al ritmo de cada tipo de operación.</p>
      </div>

      <div class="hidden gap-2 sm:flex" data-slider-controls="cases">
        <button type="button" class="slider-arrow" data-slider-prev aria-label="Caso anterior">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
          </svg>
        </button>
        <button type="button" class="slider-arrow" data-slider-next aria-label="Siguiente caso">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
          </svg>
        </button>
      </div>
    </div>

    <div class="relative mt-12">
      <div class="slider-track" data-slider="cases">
        {cases.map((c) => (
          <article class="slider-slide w-[85%] sm:w-[60%] lg:w-[34%]">
            <div class="h-full rounded-2xl border border-ink-700/8 bg-cream-50 p-7 sm:p-8">
              <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-orange-50 text-orange-600">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d={c.icon} />
                </svg>
              </div>
              <p class="mt-5 text-xs font-bold uppercase tracking-widest text-orange-600">{c.segment}</p>
              <h3 class="mt-2 text-xl">{c.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-ink-400">{c.body}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-5 flex justify-center gap-2 sm:hidden" data-slider-dots="cases"></div>
    </div>
  </div>
</section>

<script>
  function initSlider(key: string) {
    const track = document.querySelector<HTMLElement>(`[data-slider="${key}"]`);
    const dotsWrap = document.querySelector<HTMLElement>(`[data-slider-dots="${key}"]`);
    const controls = document.querySelector<HTMLElement>(`[data-slider-controls="${key}"]`);
    if (!track) return;

    const slides = Array.from(track.children) as HTMLElement[];
    const prevBtn = controls?.querySelector<HTMLButtonElement>('[data-slider-prev]');
    const nextBtn = controls?.querySelector<HTMLButtonElement>('[data-slider-next]');

    if (dotsWrap) {
      slides.forEach((_, i) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'slider-dot';
        dot.setAttribute('aria-label', `Ir a la tarjeta ${i + 1}`);
        dot.dataset.active = i === 0 ? 'true' : 'false';
        dot.addEventListener('click', () => slides[i].scrollIntoView({ behavior: 'smooth', inline: 'start' }));
        dotsWrap.appendChild(dot);
      });
    }

    function updateActive() {
      const trackRect = track!.getBoundingClientRect();
      let closestIndex = 0;
      let closestDist = Infinity;
      slides.forEach((slide, i) => {
        const dist = Math.abs(slide.getBoundingClientRect().left - trackRect.left);
        if (dist < closestDist) {
          closestDist = dist;
          closestIndex = i;
        }
      });
      dotsWrap?.querySelectorAll('.slider-dot').forEach((dot, i) => {
        (dot as HTMLElement).dataset.active = String(i === closestIndex);
      });
      if (prevBtn) prevBtn.disabled = closestIndex === 0;
      if (nextBtn) nextBtn.disabled = closestIndex === slides.length - 1;
    }

    function scrollByStep(dir: 1 | -1) {
      const amount = slides[0]?.getBoundingClientRect().width + 20;
      track!.scrollBy({ left: amount * dir, behavior: 'smooth' });
    }

    prevBtn?.addEventListener('click', () => scrollByStep(-1));
    nextBtn?.addEventListener('click', () => scrollByStep(1));
    track.addEventListener('scroll', () => requestAnimationFrame(updateActive), { passive: true });
    updateActive();
  }

  initSlider('cases');
</script>
