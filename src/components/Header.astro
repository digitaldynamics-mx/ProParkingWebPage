---
const navLinks = [
  { href: '/#producto', label: 'Producto' },
  { href: '/#como-funciona', label: 'Cómo funciona' },
  { href: '/#beneficios', label: 'Beneficios' },
  { href: '/#planes', label: 'Planes' },
  { href: '/#preguntas', label: 'Preguntas' },
  { href: '/about', label: 'Acerca de' },
];
---

<header class="sticky top-0 z-50 border-b border-ink-700/5 bg-cream-100/80 backdrop-blur-md">
  <div class="container-px flex h-18 items-center justify-between py-3">
    <a href="/" class="flex items-center gap-2" aria-label="ProParking — inicio">
      <img src="/images/logo.png" alt="ProParking — Digital Partner" class="h-9 w-auto sm:h-10" width="512" height="159" />
    </a>

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Navegación principal">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm font-semibold text-ink-500 transition-colors hover:text-orange-600"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="hidden lg:block">
      <a href="/#cta" class="btn-primary">Solicitar demo</a>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="flex h-10 w-10 items-center justify-center rounded-lg border border-ink-700/10 text-ink-700 lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú de navegación"
    >
      <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" class="hidden flex-col gap-1 border-t border-ink-700/5 bg-cream-100 px-5 pb-5 pt-3 lg:hidden" aria-label="Navegación móvil">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="rounded-lg px-3 py-2.5 text-sm font-semibold text-ink-600 hover:bg-white"
        data-menu-link
      >
        {link.label}
      </a>
    ))}
    <a href="/#cta" class="btn-primary mt-2 w-full" data-menu-link>Solicitar demo</a>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  function closeMenu() {
    menu?.classList.add('hidden');
    menu?.classList.remove('flex');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
    toggle?.setAttribute('aria-expanded', 'false');
  }

  toggle?.addEventListener('click', () => {
    const isHidden = menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', !isHidden);
    menu?.classList.toggle('flex', isHidden);
    iconOpen?.classList.toggle('hidden', isHidden);
    iconClose?.classList.toggle('hidden', !isHidden);
    toggle?.setAttribute('aria-expanded', String(isHidden));
  });

  document.querySelectorAll('[data-menu-link]').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });
</script>
