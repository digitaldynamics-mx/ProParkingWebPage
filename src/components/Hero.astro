---
---

<section id="inicio" class="relative overflow-hidden bg-ink-800">
  <!-- Glow decorativo -->
  <div class="pointer-events-none absolute -left-32 -top-32 h-96 w-96 rounded-full bg-orange-500/20 blur-3xl"></div>
  <div class="pointer-events-none absolute -right-24 top-1/3 h-80 w-80 rounded-full bg-green-500/20 blur-3xl"></div>

  <div class="container-px relative grid gap-12 py-20 sm:py-24 lg:grid-cols-2 lg:items-center lg:py-28">
    <div class="animate-fade-up">
      <span class="eyebrow bg-white/10 text-orange-300">Digital Partner para Valet Parking</span>

      <h1 class="mt-6 text-4xl !text-white sm:text-5xl lg:text-[3.25rem] lg:leading-[1.08]">
        Digitaliza la operación de tu valet parking, de principio a fin
      </h1>

      <p class="mt-6 max-w-xl text-lg text-white/70">
        ProParking reemplaza el boleto de papel con una plataforma B2B que da trazabilidad, auditoría
        y visibilidad en tiempo real sobre cada turno — pensada para hoteles, restaurantes y eventos.
      </p>

      <div class="mt-9 flex flex-col gap-3.5 sm:flex-row">
        <a href="#cta" class="btn-primary">
          Solicitar demo
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
        <a href="#como-funciona" class="btn-ghost-light">Ver cómo funciona</a>
      </div>

      <dl class="mt-12 grid grid-cols-3 gap-6 border-t border-white/10 pt-8">
        <div>
          <dt class="sr-only">Aplicaciones conectadas</dt>
          <dd class="text-2xl font-extrabold text-white sm:text-3xl">3</dd>
          <p class="mt-1 text-xs text-white/50 sm:text-sm">apps, un solo backend</p>
        </div>
        <div>
          <dt class="sr-only">Trazabilidad</dt>
          <dd class="text-2xl font-extrabold text-white sm:text-3xl">100%</dd>
          <p class="mt-1 text-xs text-white/50 sm:text-sm">boletos con bitácora</p>
        </div>
        <div>
          <dt class="sr-only">Visibilidad</dt>
          <dd class="text-2xl font-extrabold text-white sm:text-3xl">24/7</dd>
          <p class="mt-1 text-xs text-white/50 sm:text-sm">visibilidad del dueño</p>
        </div>
      </dl>
    </div>

    <div class="relative animate-fade-up [animation-delay:150ms]">
      <div class="relative mx-auto max-w-md rounded-3xl border border-white/10 bg-white/5 p-5 shadow-2xl backdrop-blur-sm sm:p-7">
        <div class="flex items-center justify-between border-b border-white/10 pb-4">
          <div class="flex items-center gap-2">
            <span class="h-2.5 w-2.5 rounded-full bg-orange-500"></span>
            <span class="text-sm font-bold text-white">Web Admin · Turno en curso</span>
          </div>
          <span class="rounded-full bg-green-500/15 px-2.5 py-1 text-[11px] font-bold text-green-300">EN VIVO</span>
        </div>

        <ul class="mt-5 space-y-3">
          {[
            { id: '#0231', estado: 'Resguardado', color: 'bg-orange-500' },
            { id: '#0230', estado: 'Cobro cerrado', color: 'bg-green-500' },
            { id: '#0229', estado: 'Vehículo entregado', color: 'bg-green-500' },
          ].map((row) => (
            <li class="flex items-center justify-between rounded-xl bg-white/5 px-4 py-3">
              <div class="flex items-center gap-3">
                <span class={`h-2 w-2 rounded-full ${row.color}`}></span>
                <span class="font-mono text-sm text-white/90">{row.id}</span>
              </div>
              <span class="text-xs font-semibold text-white/60">{row.estado}</span>
            </li>
          ))}
        </ul>

        <div class="mt-6 grid grid-cols-2 gap-3">
          <div class="rounded-xl border border-white/10 p-4">
            <p class="text-xs text-white/50">Boletos hoy</p>
            <p class="mt-1 text-xl font-extrabold text-white">128</p>
          </div>
          <div class="rounded-xl border border-white/10 p-4">
            <p class="text-xs text-white/50">Bitácora</p>
            <p class="mt-1 text-xl font-extrabold text-white">Auditada</p>
          </div>
        </div>
      </div>

      <div class="absolute -bottom-6 -left-6 hidden rounded-2xl border border-white/10 bg-ink-700 p-4 shadow-xl sm:block">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-full bg-orange-500/20 text-orange-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
            </svg>
          </div>
          <div>
            <p class="text-sm font-bold text-white">Boleto digital</p>
            <p class="text-xs text-white/50">generado y firmado</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
